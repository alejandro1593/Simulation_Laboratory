# ---- Backend (se lee desde backend/.env o variables de entorno) ----
DATABASE_URL=sqlite:///./molcore.db
# Postgres (local o Neon) ejemplo:
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/db?sslmode=require
JWT_SECRET=change-me-please
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=14
JWT_ALGORITHM=HS256
CORS_ORIGINS=["http://localhost:5173"]
DEBUG=false
SNAPSHOT_VERSION=mvp-v1

# ---- Frontend ----
# No requiere variables: el cliente usa ruta relativa /api/v1
# (proxy de Vite -> backend en desarrollo; nginx -> api en producción).