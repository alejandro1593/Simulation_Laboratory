  "experiments": [
    {
      "id": "exp-acidobase-hcl-naoh",
      "titleEs": "Valoración: ácido clorhídrico + hidróxido de sodio",
      "level": [
        "bachillerato",
        "universidad"
      ],
      "topic": "acid_base",
      "reactants": [
        "hcl",
        "naoh"
      ],
      "equation": "HCl + NaOH -> NaCl + H2O",
      "effects": [
        {
          "type": "exothermic",
          "note": "Reacción de neutralización que libera calor (dT estimado)."
        },
        {
          "type": "ph_change",
          "target": 7,
          "note": "Neutralización completa de ácido fuerte y base fuerte."
        }
      ],
      "script": [
        {
          "action": "add_solution",
          "substance": "hcl",
          "volume_ml": 50
        },
        {
          "action": "titrate",
          "substance": "naoh",
          "note": "Añade la base con la bureta hasta neutralizar (indicador si lo usas)."
        }
      ],
      "explanation": "Los iones H+ y OH- se combinan formando agua; los iones restantes (Na+ y Cl-) quedan en disolución como sales. Ácido fuerte + base fuerte neutralizan por completo.",
      "safety": "Simulación educativa. En laboratorio real: gafas, bata y campana para ácidos concentrados.",
      "dH_reference_kj_per_mol": -57.2,
      "gas": null
    },
    {
      "id": "exp-acidobase-h2so4",
      "titleEs": "Neutralización con ácido sulfúrico 1 M",
      "level": "bachillerato",
      "topic": "acid_base",
      "reactants": [
        "h2so4",
        "naoh"
      ],
      "equation": "H2SO4 + 2 NaOH -> Na2SO4 + 2 H2O",
      "effects": [
        {
          "type": "exothermic"
        },
        {
          "type": "ph_change",
          "target": 7
        }
      ],
      "script": [
        {
          "action": "add_solution",
          "substance": "h2so4",
          "volume_ml": 25
        },
        {
          "action": "add_solution",
          "substance": "naoh",
          "volume_ml": 50,
          "note": "Dos moles de base por cada mol de ácido (diprótico)."
        }
      ],
      "explanation": "El ácido sulfúrico tiene 2 protones por molécula; por eso hacen falta el doble de moles de NaOH.",
      "safety": "H2SO4 concentrado es corrosivo. Aquí siempre es una simulación.",
      "dH_reference_kj_per_mol": -111.7,
      "gas": null
    },
