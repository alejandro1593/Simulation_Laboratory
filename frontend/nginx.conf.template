server {
  listen 80 default_server;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  gzip on;
  gzip_types text/plain text/css application/javascript application/json image/svg+xml application/manifest+json;

  # API: se proxya al backend (mismo origen ante el navegador, sin CORS).
  # API_UPSTREAM es una URL completa (http://api:8000 en docker-compose local,
  # https://molcore-api.onrender.com en Render). Hostname estático: nginx lo
  # resuelve en el arranque con el DNS del sistema (resolv.conf), válido en
  # Render y en Docker.
  location /api/ {
    proxy_pass ${API_UPSTREAM};
    proxy_http_version 1.1;
    # NO se sobrescribe Host: Render enruta el tráfico público por el header Host,
    # y si se manda el de la web (molcore-web) la petición vuelve a sí misma (508 loop).
    # nginx usa por defecto el host del upstream, que apunta a la API.
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_ssl_server_name on;
  }

  # PWA: el service worker y el manifiesto nunca se cachean agresivamente.
  location = /sw.js {
    add_header Cache-Control "no-cache";
    try_files $uri =404;
  }
  location = /manifest.webmanifest {
    add_header Cache-Control "no-cache";
    try_files $uri =404;
  }

  # Estáticos con hash de Vite: caché larga inmutable.
  location ~* \.(?:js|css|map|png|jpe?g|gif|svg|webp|ico|woff2?)$ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    try_files $uri =404;
  }

  # SPA: cualquier ruta cae en index.html.
  location / {
    try_files $uri $uri/ /index.html;
  }
}